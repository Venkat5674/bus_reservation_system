# =================================================================
# Production Environment Variables Template for Oracle Cloud VM
# Copy this file to .env.production on your server and chmod 600
# DO NOT COMMIT SENSITIVE VALUES TO GIT
# =================================================================

# Spring Profiles Active (prod enables PostgreSQL, secure logging, and actuator limits)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Internal port; proxy via Nginx port 80/443)
PORT=8080

# Database Configuration (PostgreSQL / Supabase / OCI Managed DB)
# Option A: Full JDBC URL (Recommended)
DB_URL=jdbc:postgresql://localhost:5432/bus_reservation_db?sslmode=prefer

# Option B: Component parameters (If DB_URL is not set directly)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bus_reservation_db
DB_USER=bus_app_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_SSLMODE=prefer

# Security & JWT Configuration (Must be a 64+ hex-character secret)
JWT_SECRET=REPLACE_WITH_STRONG_256BIT_HEX_SECRET_KEY
JWT_EXPIRATION_MS=604800000

# Initial Admin Seeding Configuration
ADMIN_NAME=Admin Venkatesh
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
